{
  "name": "@mcp/secret-mcp-server",
  "display_name": "Secret MCP",
  "description": "A secret manager server for MCP.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyeongjin/secret_mcp"
  },
  "author": {
    "name": "Yeongjin Yi"
  },
  "license": "MIT",
  "categories": [
    "Dev Tools",
    "MCP Tools"
  ],
  "tags": [
    "mcp",
    "secret"
  ],
  "arguments": {
    "SECRET_STORE_PATH": {
      "description": "Path to the secret store file.",
      "required": false,
      "example": "secret-store.json"
    },
    "PORT": {
      "description": "Port to listen on.",
      "required": false,
      "example": "3000"
    },
    "HOST": {
      "description": "Host to bind to.",
      "required": false,
      "example": "0.0.0.0"
    }
  },
  "tools": [
    {
      "name": "addSecret",
      "description": "Add a new secret",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The key for the secret."
          },
          "value": {
            "type": "string",
            "description": "The value of the secret."
          }
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    {
      "name": "getSecret",
      "description": "Get a secret",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The key of the secret to retrieve."
          }
        }
      },
      "required": [
        "key"
      ]
    },
    {
      "name": "deleteSecret",
      "description": "Delete a secret",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The key of the secret to delete."
          }
        }
      },
      "required": [
        "key"
      ]
    },
    {
      "name": "listSecrets",
      "description": "List all secret keys",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "required": []
    }
  ],
  "installations": {
    "npm": {
      "type": "npm",
      "command": "npx",
      "args": [
        "-y",
        "@mcp/secret-mcp-server"
      ],
      "package": "@mcp/secret-mcp-server",
      "description": "Run the server using npx. This is the recommended method for most users.",
      "recommended": true
    },
    "docker": {
      "type": "docker",
      "command": "docker",
      "args": [
        "run",
        "-p",
        "3000:3000",
        "-v",
        "$(pwd)/secret-store.json:/app/secret-store.json",
        "yyeongjin/secret-mcp-server"
      ],
      "description": "Run the server using Docker. This method is suitable for containerized environments."
    }
  },
  "is_official": false,
  "is_archived": false,
  "docker_url": "yyeongjin/secret-mcp-server"
}