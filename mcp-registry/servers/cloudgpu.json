{
  "name": "cloudgpu",
  "display_name": "CloudGPU",
  "description": "Let an AI agent discover GPUs, get a cost quote, rent a GPU instance or run a job, upload and download files, read logs and shut it down, with spend, time and idle limits enforced server-side.",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudgpu-app/cloudgpu-mcp"
  },
  "homepage": "https://cloudgpu.app/docs/mcp",
  "author": {
    "name": "CloudGPU"
  },
  "license": "MIT",
  "categories": [
    "AI Systems",
    "Dev Tools"
  ],
  "tags": [
    "gpu",
    "compute",
    "cloud",
    "jobs",
    "agents"
  ],
  "installations": {
    "npm": {
      "type": "npm",
      "command": "npx",
      "args": [
        "-y",
        "cloudgpu-mcp"
      ],
      "package": "cloudgpu-mcp",
      "description": "Run the CloudGPU MCP server from npm. No API key needed at install: the agent calls connect_account and the owner approves a key with a spending limit through a link.",
      "recommended": true
    }
  },
